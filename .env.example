# Local environment template. Native binaries do not load .env automatically;
# export selected values through your shell/service manager. Compose supplies its
# own environment and does not pass this file through automatically.
# Some values below deliberately select local dependencies rather than binary
# defaults. Full defaults, constraints, and deployment overrides:
# docs/configuration.md

# --- service identity --------------------------------------------------------
SERVICE_NAME=fluxgate-ingest-api
# One of: local, dev, staging, prod
ENVIRONMENT=local

# --- http listener -----------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=120s
# Must be shorter than HTTP_WRITE_TIMEOUT so a timeout response can be flushed.
HTTP_HANDLER_TIMEOUT=10s
# Accepts a plain byte count or a KB/MB/GB suffix.
HTTP_MAX_REQUEST_BYTES=4MB
# Active non-stream data handlers. Excess work gets 503 with Retry-After.
# Increase only after measuring peak request memory at your container size.
HTTP_MAX_CONCURRENT=4
# Only enable behind a proxy that rewrites X-Forwarded-For.
HTTP_TRUST_PROXY_HEADER=false
# Enable only behind a gateway that authenticates/replaces incoming trace context.
# Public callers are linked to a new trace and cannot force sampling.
HTTP_TRUST_TRACE_PARENT=false

# --- logging -----------------------------------------------------------------
# One of: debug, info, warn, error
LOG_LEVEL=info
# One of: json, text
LOG_FORMAT=json
LOG_ADD_SOURCE=false

# --- authentication ----------------------------------------------------------
# Turns authentication off and attributes every request to the "anonymous"
# tenant. Defaults to true on the local tier so a fresh clone runs with no
# setup; configuration validation REFUSES this on staging and prod.
AUTH_DISABLED=true

# The API key document, as inline JSON. Required (or API_KEYS_FILE) whenever
# authentication is enabled. Only the SHA-256 digest of each secret is stored.
# Generate one with:  printf %s "$SECRET" | sha256sum
# API_KEYS=[{"key_id":"k1","tenant_id":"acme","secret_sha256":"<hex>","rate_limit_per_second":5000,"burst":10000}]

# Path to the same document on disk. This is how a secret manager mounts
# credentials into a container. API_KEYS wins when both are set.
# API_KEYS_FILE=/etc/fluxgate/api-keys.json

# --- ingestion ---------------------------------------------------------------
INGEST_MAX_POINTS_PER_BATCH=1000
# How far ahead of the server a timestamp may be, to tolerate client clock drift.
INGEST_MAX_CLOCK_SKEW=5m
# How far back a timestamp may be at HTTP admission. Accepted late data can
# correct an older window; window closure alone is not a rejection boundary.
INGEST_MAX_BACKFILL=168h

# Quota is metered in POINTS per second, not requests: batching must not let a
# caller evade its allowance. Limits apply per tenant per instance; replicas
# multiply the total allowance.
RATE_LIMIT_POINTS_PER_SECOND=10000
# Must be at least INGEST_MAX_POINTS_PER_BATCH, or a full batch could never be
# admitted no matter how long the client waited.
RATE_LIMIT_BURST=20000

# Reservation lifetime measured from first reservation, not refreshed by retries.
# Retry the identical body and Idempotency-Key before expiry.
IDEMPOTENCY_TTL=24h

# --- pub/sub transport -------------------------------------------------------
# Selects the durable transport over the in-memory sink. Defaults to true on
# every tier except local, and to true on local as soon as an emulator host is
# set. Validation REFUSES false on staging and prod: the in-memory sink
# acknowledges batches and then discards them.
# PUBSUB_ENABLED=true

# Required whenever the transport is enabled.
GCP_PROJECT_ID=fluxgate-local

# Points the client at a local emulator. This is the variable the Google client
# libraries already read, so it is honoured rather than duplicated.
#   docker compose -f deploy/docker-compose.yml up -d pubsub
PUBSUB_EMULATOR_HOST=localhost:8681

# Creates missing topics and subscriptions at startup. Defaults to true only
# when an emulator is configured, and validation refuses it on staging and prod:
# creating topology needs runtime admin credentials, which is a far larger blast
# radius than publish-and-subscribe.
# PUBSUB_BOOTSTRAP=true

PUBSUB_TOPIC_RAW=telemetry-raw
PUBSUB_TOPIC_DLQ=telemetry-dlq
PUBSUB_SUBSCRIPTION_AGGREGATOR=telemetry-aggregator

# Match the actual source and dead-letter replay horizons in infrastructure.
PUBSUB_RETENTION=24h
PUBSUB_DLQ_RETENTION=168h

PUBSUB_PUBLISH_TIMEOUT=10s
# How long the client accumulates messages before sending a batch.
PUBSUB_BATCH_DELAY=10ms
PUBSUB_BATCH_COUNT=100
# Exceeding these sheds load rather than buffering without bound.
PUBSUB_MAX_OUTSTANDING_MESSAGES=1000
PUBSUB_MAX_OUTSTANDING_BYTES=64MB

# Consecutive publish failures that trip the circuit breaker, and how long it
# fails fast before probing for recovery.
PUBSUB_BREAKER_FAILURE_THRESHOLD=5
PUBSUB_BREAKER_COOLDOWN=10s

# --- database ---------------------------------------------------------------
# Required by aggregator/query/migrate, and by ingest on staging/prod for durable
# retry reservations. Supplying it locally enables shared ingest retries too.
# Optional IAM-authorized private Cloud SQL connector (project:region:instance).
CLOUD_SQL_INSTANCE=
DATABASE_URL=postgres://fluxgate:fluxgate@localhost:5442/fluxgate?sslmode=disable
# Size the pool against the database's own connection limit divided by the
# replica count, not against how much concurrency this process would like.
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_CONNECT_TIMEOUT=10s
# Ingest/aggregator apply development startup migrations under an advisory lock.
# Query never migrates. Staging/prod rejects true; use the separate migration job.
DATABASE_MIGRATE=true

# --- aggregation -------------------------------------------------------------
# Every rollup covers exactly this much event time.
AGGREGATOR_WINDOW_SIZE=1m
# How far the event-time watermark trails the highest observed timestamp.
# Durable checkpoints can expose partial windows sooner and accept corrections.
AGGREGATOR_ALLOWED_LATENESS=30s
# How long a producer may be silent before idle event-time watermark advancement.
# Durable worker checkpoints also persist partial windows without waiting for it.
AGGREGATOR_IDLE_TIMEOUT=30s
# Capacity rejects whole deliveries for retry and requests an early checkpoint.
AGGREGATOR_MAX_SERIES=100000
# Retained series admission budget; minimum 32MB. Flushes need separate headroom.
AGGREGATOR_MAX_BUFFERED_BYTES=128MB
# Broker wire-data budget; decoded data also needs headroom. Minimum 10MB.
AGGREGATOR_MAX_OUTSTANDING_BYTES=16MB
# Must not exceed AGGREGATOR_WINDOW_SIZE. This timer also checkpoints partial windows.
AGGREGATOR_FLUSH_INTERVAL=15s
# Simultaneous tenant transactions per worker (1..16); uses the existing DB pool.
AGGREGATOR_FLUSH_CONCURRENCY=4
# Deadline for one ledger lookup or whole checkpoint including queued tenants (1s..2m).
# Expiry rolls back and returns uncommitted deliveries for retry.
AGGREGATOR_STORAGE_TIMEOUT=1m
AGGREGATOR_MAX_OUTSTANDING_MESSAGES=1000
AGGREGATOR_CONCURRENCY=2

# --- retention ---------------------------------------------------------------
ROLLUP_RETENTION=720h
# Must outlive the longest redelivery Pub/Sub could produce, or a redelivered
# batch could be counted twice. Staging/prod requires source retention + DLQ
# retention + retry TTL + 24h safety; all tiers require at least one window.
LEDGER_RETENTION=768h
PRUNE_INTERVAL=5m

# --- query api ---------------------------------------------------------------
# Every limit here exists because the read path is the easy way to hurt a
# telemetry system: one unbounded query over a year of one-minute windows
# across a thousand series is half a billion rows, and the client that asked
# for it is usually a dashboard that will ask again in thirty seconds.
QUERY_MAX_RANGE=744h
QUERY_MAX_SERIES=500
QUERY_MAX_POINTS=50000
# Applied when the caller supplies neither bound. Must not exceed
# QUERY_MAX_RANGE, or every parameterless request would fail its own validation.
QUERY_DEFAULT_RANGE=1h

# Concurrent stream bounds per instance.
QUERY_STREAM_MAX_CONCURRENT=100
# Prevent one tenant from taking every stream slot; per instance, capped by total.
QUERY_STREAM_MAX_PER_TENANT=8
# How often the live tail checks for newly written rollups.
QUERY_STREAM_POLL_INTERVAL=2s
# Keep-alive cadence on an idle stream, so an intermediary does not close a
# connection it believes is dead. Must be shorter than the maximum duration.
QUERY_STREAM_HEARTBEAT=20s
# Bounds one streaming connection. Clients must reconnect and reconcile through
# REST; missed SSE updates are not replayed on a new connection.
QUERY_STREAM_MAX_DURATION=30m

# --- observability -----------------------------------------------------------
# The collector's OTLP gRPC address. This is the variable the OpenTelemetry
# SDKs already read, so it is honoured rather than duplicated under a
# Fluxgate-specific name that could disagree with it. Setting it also enables
# tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# Only appropriate for a collector on a loopback or a private mesh.
OTEL_EXPORTER_OTLP_INSECURE=true
# TRACING_ENABLED=true

# Fraction of traces recorded. Defaults to 1 on local and dev and 0.05 on
# staging and prod: tracing every request is affordable while developing and
# ruinous at ingest volumes.
TRACE_SAMPLE_RATIO=1
TRACE_EXPORT_TIMEOUT=10s

# The Prometheus scrape endpoint, served on the same listener as the API.
# Staging/prod defaults false; public data APIs reject true on those tiers.
METRICS_ENABLED=true
METRICS_PATH=/metrics

# --- shutdown ----------------------------------------------------------------
# How long to keep serving while failing readiness, so load balancers can
# remove this instance from rotation before the listener closes.
SHUTDOWN_GRACE_PERIOD=5s
SHUTDOWN_DRAIN_TIMEOUT=25s

# Ingest staging/prod requires DATABASE_URL for shared, durable retry reservations.
# Apply database migrations before starting ingest. In-memory retries are local
# development only. Retry the identical body within IDEMPOTENCY_TTL (default 24h).
